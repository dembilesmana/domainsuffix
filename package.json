{
  "name": "domainame",
  "version": "1.0.3",
  "description": "Extracts the public domain suffix from hosts, URLs, and request-like objects.",
  "keywords": [
    "domain",
    "host",
    "request",
    "suffix",
    "url"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dembilesmana/domainame.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "build": "bun run build.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "publish": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.12",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
